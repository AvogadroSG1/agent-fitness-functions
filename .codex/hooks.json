{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "./.claude/hooks/guard",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "\"$(git rev-parse --git-path hooks/agent-fitness-functions-git-guard)\"",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "AGENT_FITNESS_FUNCTIONS_HISTORY_TOOL=codex \"$(git rev-parse --git-path hooks/agent-fitness-functions-pre-tool-use)\"",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime || true",
            "type": "command"
          },
          {
            "command": "instill sync || true",
            "type": "command"
          },
          {
            "command": "command -v forge \u003e/dev/null 2\u003e\u00261 \u0026\u0026 forge sync-allowlist --check || true",
            "type": "command"
          },
          {
            "command": "command -v forge \u003e/dev/null 2\u003e\u00261 \u0026\u0026 forge upgrade --check || true",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
