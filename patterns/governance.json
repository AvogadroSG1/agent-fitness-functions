{
  "$schema": "https://calm.finos.org/release/1.2/meta/calm.json",
  "$id": "https://stackoverflow.com/calm-poc/patterns/governance.json",
  "title": "Agent Fitness Functions",
  "description": "FINOS CALM pattern enforcing Agent Fitness Functions governance.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "https://calm.finos.org/release/1.2/meta/core.json#/defs/node",
        "type": "object",
        "properties": {
          "metadata": {
            "type": "object",
            "properties": {
              "fitness": {
                "type": "object",
                "properties": {
                  "cyclomatic-complexity": {
                    "description": "Maximum cyclomatic complexity per function",
                    "type": "number",
                    "maximum": 9
                  },
                  "interface-width": {
                    "description": "Maximum public method count per CALM node",
                    "type": "number",
                    "maximum": 20
                  },
                  "implementation-depth": {
                    "description": "Minimum average implementation LOC per public method",
                    "type": "number",
                    "minimum": 0.722
                  },
                  "logic-density": {
                    "description": "Minimum logic density ratio per file",
                    "type": "number",
                    "minimum": 0.255
                  },
                  "dependency-discipline": {
                    "description": "Minimum used-import ratio per file",
                    "type": "number",
                    "minimum": 0.8
                  },
                  "layer-sovereignty": {
                    "description": "Maximum layer-sovereignty violations per file",
                    "type": "number",
                    "exclusiveMaximum": 1
                  },
                  "temporal-purity": {
                    "description": "Maximum temporal-purity violations per file",
                    "type": "number",
                    "exclusiveMaximum": 1
                  },
                  "sql-composition-safety": {
                    "description": "Maximum sql-composition-safety violations per file",
                    "type": "number",
                    "exclusiveMaximum": 1
                  },
                  "deterministic-ordering": {
                    "description": "Maximum deterministic-ordering violations per file",
                    "type": "number",
                    "exclusiveMaximum": 1
                  }
                },
                "required": [
                  "cyclomatic-complexity",
                  "interface-width",
                  "implementation-depth",
                  "logic-density",
                  "dependency-discipline"
                ]
              }
            },
            "required": [
              "fitness"
            ]
          }
        },
        "required": [
          "metadata"
        ]
      }
    },
    "relationships": {
      "type": "array"
    }
  },
  "required": [
    "nodes",
    "relationships"
  ]
}
