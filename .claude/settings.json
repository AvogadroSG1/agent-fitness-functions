{
  "enabledPlugins": {},
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "AGENT_FITNESS_FUNCTIONS_ADDR=http://127.0.0.1:7890 AGENT_FITNESS_FUNCTIONS_REPO_NAME=agent-fitness-functions \"$(git rev-parse --show-toplevel)/hooks/pre-tool-use.sh\"",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "./.claude/hooks/guard",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime || true",
            "type": "command"
          },
          {
            "command": "instill sync || true",
            "type": "command"
          },
          {
            "command": "command -v forge >/dev/null 2>&1 && forge sync-allowlist --check || true",
            "type": "command"
          },
          {
            "command": "command -v forge >/dev/null 2>&1 && forge upgrade --check || true",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
