{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "STACK_FITNESS_FUNCTIONS_BIN=\"$(pwd)/.tmp/calm-bridge\" STACK_FITNESS_FUNCTIONS_ADDR=https://127.0.0.1:7890 STACK_FITNESS_FUNCTIONS_CLIENT_CERT=\"$(pwd)/certs/client.crt\" STACK_FITNESS_FUNCTIONS_CLIENT_KEY=\"$(pwd)/certs/client.key\" STACK_FITNESS_FUNCTIONS_CLIENT_CA=\"$(pwd)/certs/ca.crt\" STACK_FITNESS_FUNCTIONS_REPO_NAME=calm-poc \"$(pwd)/hooks/pre-tool-use.sh\""
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ],
        "matcher": ""
      }
    ]
  }
}