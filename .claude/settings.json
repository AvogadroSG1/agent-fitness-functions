{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_FITNESS_FUNCTIONS_BIN=\"$(pwd)/.tmp/agent-fitness-functions\" AGENT_FITNESS_FUNCTIONS_ADDR=https://127.0.0.1:7890 AGENT_FITNESS_FUNCTIONS_DEV_CERT_DIR=\"$(pwd)/certs\" AGENT_FITNESS_FUNCTIONS_REPO_NAME=calm-poc \"$(pwd)/hooks/pre-tool-use.sh\""
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
